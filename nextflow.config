manifest {
    mainScript = 'main.nf'
}


env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

tower {
   workspaceId = '177909724754793'
   enabled = true

}

profiles {
    standard {
       process {
	    container = 'biocorecrg/debian-perlbrew:buster'
            containerOptions = { workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g)': null}
            cache='lenient'
    	    queue='short-centos79,short-rocky9,long-centos79'
            cpus='1'
            time='6h'
            errorStrategy = {task.attempt <= 2 ? 'retry' : 'ignore'}
            maxRetries = 3
            memory = {8.GB * task.attempt}
   	    time = {6.h * task.attempt}
            executor = "crg"   
      withLabel:big_cpus {
             cpus = 8
      	     memory = {16.GB * task.attempt}

	}

       
       withLabel: big_mem_cpus {
            cpus = 8
            memory = {64.GB * task.attempt}
       }
 
       withLabel: ignore {
            errorStrategy = 'ignore'

       }
       withLabel: big_mem {
           cpus = 1
           memory = '80G'
       }

	withLabel: basecall_gpus {
   		queue = 'gpu_novoa,gpu,gpu_long'
   		memory = '12G'
   		clusterOptions = '-l gpu=1'
   		//singularity.envWhitelist = "CUDA_VISIBLE_DEVICES,SGE_HGR_gpu"
   		containerOptions = { workflow.containerEngine == "singularity" ? '--nv':
      		( workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g) --gpus all': null ) }
	 }
   }
   singularity.enabled = true
}
   

local {
         process {
            container = 'biocorecrg/debian-perlbrew:buster'
            executor = 'local'
            memory='4G'
            cpus='1'
         }
   singularity.enabled = true

   }


ci {
         process {
            container = 'biocorecrg/debian-perlbrew:buster'
            containerOptions = { workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g)': null}

            memory='4G'
            cpus='2'
         }
   }
}


singularity.cacheDir = "/software/bi/biocore_tools/singularity_containers/"



