# This will do biocorecrg/tapestri:2.0.1
FROM ubuntu:focal

RUN apt-get update
RUN apt-get install -y build-essential
RUN apt install -y git zlib1g zlib1g-dev wget libbz2-dev liblzma-dev

# Create biocontainers-like directories
RUN mkdir /data /config

# Add user biodocker with password biodocker
RUN groupadd fuse && \
    useradd --create-home --shell /bin/bash --user-group --uid 1000 --groups sudo,fuse biodocker && \
    echo `echo "biodocker\nbiodocker\n" | passwd biodocker` && \
    chown biodocker:biodocker /data && \
    chown biodocker:biodocker /config

# Change user. We imitate biocontainers
USER biodocker

ENV PATH=$PATH:/home/biodocker/bin
ENV HOME=/home/biodocker

WORKDIR /home/biodocker

RUN wget https://dl.missionbio.io/onprem-miniconda/TapestriPipeline-v2.0.1-Linux-x86_64.sh; sh TapestriPipeline-v2.0.1-Linux-x86_64.sh
RUN rm TapestriPipeline-v2.0.1-Linux-x86_64.sh
ENV PATH="$HOME/tapestripipeline/bin:${PATH}"
RUN $HOME/tapestripipeline/bin/conda init bash
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

VOLUME ["/data", "/config"]

ENTRYPOINT ["bash", "-l", "-c"]
WORKDIR /data
