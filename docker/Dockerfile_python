# This will do biocorecrg/doubletdetection:0.2
FROM python:3.7

# File Author / Maintainer
LABEL org.opencontainers.image.authors="Luca Cozzuto <lucacozzuto@gmail.com>" 

#upgrade pip
RUN apt-get update
RUN apt install build-essential 
RUN pip3 install --upgrade pip
RUN pip3 install --upgrade setuptools wheel
RUN pip3 install leidenalg
RUN pip3 install doubletdetection 
#pandas argparse

#Install samtools
RUN wget https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2
RUN cd samtools-1.21; make && make install
