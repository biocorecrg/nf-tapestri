process {
    env.HOME = "/tmp"
    container = 'biocorecrg/debian-perlbrew:buster'
    cache='lenient'
    cpus='1'
    errorStrategy ='retry'
    maxRetries = 2
    memory = {8.GB * task.attempt}
    time = {3.h * task.attempt}
    executor = "slurm"
    // custom account for IBIDAPS group
    clusterOptions = "--account=cli39" 

    withLabel:big_cpus {
        cpus = 8
        time = {6.h * task.attempt}
        memory = {16.GB * task.attempt}

    }
    withLabel:big_time_cpus {
        memory = {100.GB * task.attempt}
        time = {24.h * task.attempt}
        cpus = 8
    }   
    withLabel: big_mem_cpus {
        time = {6.h * task.attempt}
        cpus = 8
        memory = {64.GB * task.attempt}
   }


    withLabel:big_mem_time {
        memory = {100.GB * task.attempt}
        time = {24.h * task.attempt}
    }

    withLabel: big_mem_time_cpus {
          cpus = 8
          memory = {100.GB * task.attempt}
          time = {9.h * task.attempt}
    } 
    withLabel: ignore {
          errorStrategy = 'ignore'
    }
    withLabel: big_mem {
          memory = {100.GB * task.attempt}
    } 
    withLabel: big_mem_skip {
          errorStrategy = 'ignore'
          memory = {52.GB * task.attempt}
    }
}

singularity.enabled = true
   


