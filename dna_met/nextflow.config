manifest {
    mainScript = 'main.nf'
}


env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

tower {
   workspaceId = '177909724754793'
   //enabled = true

}

profiles {
    standard {

       process {
	    container = 'biocorecrg/debian-perlbrew:buster'
            containerOptions = { workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g)': null}
            cache='lenient'
    	    queue='short-centos79,short-rocky9,long-centos79,biocore-el7'
            cpus='1'
            time='6h'
            errorStrategy ='retry'
            //errorStrategy = {task.attempt <= 2 ? 'retry' : 'ignore'}
            maxRetries = 3
            memory = {8.GB * task.attempt}
   	        time = {6.h * task.attempt}
            executor = "crg"   

		  withLabel:big_cpus {
				cpus = 8
				memory = {16.GB * task.attempt}
	
		  }
	
		   withLabel: big_mem_cpus {
				cpus = 8
				memory = {64.GB * task.attempt}
		   }
	 
	
		  withLabel:big_mem_time {
				memory = {100.GB * task.attempt}
				time = {24.h * task.attempt}
		  }

                  withLabel:big_time_cpus {
                                memory = {100.GB * task.attempt}
                                time = {24.h * task.attempt}
                                cpus = 8
                  }	
	
		   withLabel: ignore {
				errorStrategy = 'ignore'
	
		   }
		   withLabel: big_mem {
			   memory = {52.GB * task.attempt}
		   }
                   withLabel: big_mem_skip {
                       errorStrategy = 'ignore'    
                       memory = {52.GB * task.attempt}
                   }
	   }
	singularity.enabled = true
   }

    slurm {

       process {
	    container = 'biocorecrg/debian-perlbrew:buster'
            cache='lenient'
    	    queue='genoa64'
            cpus='1'
            errorStrategy ='retry'
            maxRetries = 2
            memory = {8.GB * task.attempt}
   	    time = {3.h * task.attempt}
            executor = "slurm"
            clusterOptions = { task.time <= 3.h ? '--qos=shorter' : 
            (task.time <= 6.h ? '--qos=short' : 
            (task.time <= 12.h ? '--qos=normal' : 
            (task.time <= 24.h ? '--qos=long' : 
            (task.time <= 48.h ? '--qos=vlong' : '--qos=marathon' )))) }
   

		  withLabel:big_cpus {
		        cpus = 8
   	                time = {6.h * task.attempt}
		        memory = {16.GB * task.attempt}
	
		  }
	          withLabel:big_time_cpus {
                        memory = {36.GB * task.attempt}
                        time = {24.h * task.attempt}                                  
                        cpus = 8
                  }   
		   withLabel: big_mem_cpus {
   	            time = {6.h * task.attempt}
				cpus = 8
				memory = {64.GB * task.attempt}
		   }
	 
	
		  withLabel:big_mem_time {
				memory = {36.GB * task.attempt}
				time = {24.h * task.attempt}
		  }
	
                  withLabel: big_mem_time_cpus {
                                cpus = 8
                                memory = {64.GB * task.attempt}
                                time = {9.h * task.attempt}
                  }	
		  withLabel: ignore {
				errorStrategy = 'ignore'
	
		  }
		   withLabel: big_mem {
			   memory = {52.GB * task.attempt}
		   }
                   withLabel: big_mem_skip {
                       errorStrategy = 'ignore'
                       memory = {52.GB * task.attempt}
                   }
	   }
	singularity.enabled = true
   }
   

local {
         process {
            container = 'biocorecrg/debian-perlbrew:buster'
            executor = 'local'
            memory='4G'
            cpus='1'
         }
   singularity.enabled = true

   }


ci {
         process {
            container = 'biocorecrg/debian-perlbrew:buster'
            containerOptions = { workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g)': null}

            memory='4G'
            cpus='2'
         }
   }
}


// Change this for a different cache dir
//singularity.cacheDir = "/software/bi/biocore_tools/singularity_containers/"



